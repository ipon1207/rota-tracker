{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": [
      "cn",
      "cva",
      "clsx",
      "twMerge"
    ]
  },
  "ignorePatterns": [
    "dist/**", 
    "node_modules/**",
    "playwright-report/**",
    "test-results/**",
    "src/lib/api/schema.gen.ts"
  ]
}
