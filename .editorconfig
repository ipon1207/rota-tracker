# このリポジトリのルート。上位ディレクトリの .editorconfig は探索しない
root = true

# ---------------------------------------------------------------
# 全ファイル共通
# ---------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown は行末2スペースが改行の意味を持つ
[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------
# フロントエンド
# 実際の整形は oxfmt が行う。ここはエディタの初期挙動を揃えるだけ。
# 値が食い違うと保存のたびに書き戻し合いになるので .oxfmtrc.json と揃えること
# ---------------------------------------------------------------
[*.{ts,tsx,js,jsx,json,jsonc,css,html}]
indent_size = 2

# ---------------------------------------------------------------
# C#
# dotnet format が読むのはここ。書かなければ何も検査されない
# ---------------------------------------------------------------
[*.cs]
indent_size = 4
end_of_line = crlf

#--- using の並び ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

#--- 名前空間・ブロック ---
# .NET 6 以降の書き方。ネストが1段浅くなる
csharp_style_namespace_declarations = file_scoped:warning
# 1行でも波括弧を省略しない。行を足したときのバグを防ぐ
csharp_prefer_braces = true:warning
# C# は開き波括弧を次の行に置く（Allman）
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

#--- var の使い分け ---
# 右辺を見れば型が分かるときだけ var。Dapper の戻り値のように
# 型が読み取れない場合は明示させる
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_elsewhere = false:suggestion

#--- 式・パターン ---
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion

#--- null 周り ---
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

#--- 可読性 ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
csharp_style_prefer_range_operator = true:suggestion

#--- 未使用コードの検出 ---
# 消し忘れをコンパイル時に気づける
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_unused_value_assignment_preference = discard_variable:warning

#--- 命名規則 ---
# インターフェイスは I で始める
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

# private フィールドは _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = prefix_underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.prefix_underscore_camel.required_prefix = _
dotnet_naming_style.prefix_underscore_camel.capitalization = camel_case

# 型・メソッド・プロパティは PascalCase
dotnet_naming_rule.members_pascal_case.severity = warning
dotnet_naming_rule.members_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_pascal_case.style = pascal
dotnet_naming_symbols.member_symbols.applicable_kinds = class,struct,interface,enum,method,property,event,namespace
dotnet_naming_style.pascal.capitalization = pascal_case

# 非同期メソッドは Async で終える
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_rule.async_methods_end_in_async.symbols = async_method_symbols
dotnet_naming_rule.async_methods_end_in_async.style = suffix_async
dotnet_naming_symbols.async_method_symbols.applicable_kinds = method
dotnet_naming_symbols.async_method_symbols.required_modifiers = async
dotnet_naming_style.suffix_async.required_suffix = Async
dotnet_naming_style.suffix_async.capitalization = pascal_case

# ---------------------------------------------------------------
# .NET のプロジェクト/ソリューションファイル
# ---------------------------------------------------------------
[*.{csproj,props,targets,slnx}]
indent_size = 2

# ---------------------------------------------------------------
# SQL（schema.sql / seed.sql）
# ---------------------------------------------------------------
[*.sql]
indent_size = 4
