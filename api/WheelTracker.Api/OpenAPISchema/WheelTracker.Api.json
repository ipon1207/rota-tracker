{
  "openapi": "3.1.1",
  "info": {
    "title": "WheelTracker.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "プロジェクト一覧の取得",
        "description": "登録済みプロジェクトをカテゴリ・プロジェクトの表示順で全件返す。該当が0件の場合は空配列を返す。",
        "operationId": "GetAllProjects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "required": [
          "id",
          "categoryId",
          "title",
          "difficulty"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "id"
          },
          "categoryId": {
            "type": "string",
            "description": "category_id"
          },
          "title": {
            "type": "string",
            "description": "title"
          },
          "difficulty": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "difficulty",
            "format": "int32"
          }
        },
        "description": "Projectテーブルのレコード構造"
      }
    }
  },
  "tags": [
    {
      "name": "Projects"
    }
  ]
}