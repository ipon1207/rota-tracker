{
  "openapi": "3.1.1",
  "info": {
    "title": "WheelTracker.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/projects": {
      "get": {
        "tags": [
          "WheelTracker.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "required": [
          "id",
          "categoryId",
          "title",
          "difficulty"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "difficulty": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "WheelTracker.Api"
    }
  ]
}